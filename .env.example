# Web3 Portal - Environment Variables Template
# Copy this file to `.env` and fill in your own values.
# DO NOT commit the real `.env` file — it is git-ignored.

# ── Auth ──
JWT_SECRET=your-jwt-secret-here

# ── MySQL ──
MYSQL_HOST=127.0.0.1
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
# docker-compose 的 mysql 容器 root 密码（以 ${MYSQL_ROOT_PASSWORD:?} 强制要求，缺失或为空会让 `docker compose up` 直接报错）
MYSQL_ROOT_PASSWORD=

# ── Redis ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 注意：docker-compose.yml 以 ${REDIS_PASSWORD:?} 强制要求此变量，留空会让 `docker compose up` 直接报错，
# 故模板给出示例值；本地原生 Redis 无密码时，请在自己的 .env 中清空该值即可。
REDIS_PASSWORD=change-me

# ── Nacos ──
NACOS_SERVER=127.0.0.1:8848
# 是否启用 Nacos 注册/配置（本地单机调试可置 false，服务仍可启动）
NACOS_ENABLED=false

# ── JWT 有效期（分钟）──
# access token 默认 120，refresh 默认 43200（30 天）。access 不宜过长，泄漏窗口过大。
JWT_EXPIRE_MINUTES=120
JWT_REFRESH_MINUTES=43200

# ── 服务地址（网关路由用；全部留空即全部指向 localhost，容器/多机部署时才需覆盖）──
# 例：docker compose 中 user-service 的服务名是 user-service，则填 USER_SERVICE_HOST=user-service
USER_SERVICE_HOST=localhost
BLOG_SERVICE_HOST=localhost
FORUM_SERVICE_HOST=localhost
SHOP_SERVICE_HOST=localhost
MEDIA_SERVICE_HOST=localhost
QUANT_SERVICE_HOST=localhost
TOOL_SERVICE_HOST=localhost
RESOURCE_SERVICE_HOST=localhost
SOFTWARE_SERVICE_HOST=localhost
SOFTWARE_SERVICE_PORT=8090
ADMIN_SERVICE_HOST=localhost
AI_PROXY_SERVICE_HOST=localhost
JARVIS_SERVICE_HOST=localhost
PY_SERVICE_HOST=localhost
NETEASE_API_HOST=localhost

# ── media-service 外部可执行文件 ──
# 留空则按 PATH 查找；Windows 建议填绝对路径，如 C:/tools/ffmpeg/bin/ffmpeg.exe
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# ── RabbitMQ (jarvis-service) ──
RABBITMQ_HOST=127.0.0.1
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# docker-compose 的 rabbitmq 容器使用以下变量（缺失或为空会让 `docker compose up` 直接报错）
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# ── AI Proxy Service ──
AI_PROXY_TOKEN_SECRET=your-ai-proxy-token-secret
AI_PROXY_CHANNEL_KEY_SECRET=0123456789abcdef0123456789abcdef

# ── Gateway CORS ──
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ══════════════════════════════════════════════════════════════
# Third-party API keys (optional — services start without these)
# ══════════════════════════════════════════════════════════════

# ── Gateway 第三方接口（极速数据 / ShowApi）──
# 极速数据: https://www.jisuapi.com/  → 个人中心 → API Key
J8Y_APP_KEY=
# ShowApi: https://www.showapi.com/  → 账户设置 → appKey
SHOWAPI_APP_KEY=

# ── AI Proxy LLM 提供商（填入第一个非空的将被使用）──
# DeepSeek: https://platform.deepseek.com/  → API Keys
DEEPSEEK_API_KEY=
# 硅基流动: https://cloud.siliconflow.cn/  → API 密钥
SILICONFLOW_API_KEY=
# Groq: https://console.groq.com/  → API Keys
GROQ_API_KEY=
# 豆包/火山方舟: https://www.volcengine.com/  → 方舟管理 → API Key
DOUBAO_API_KEY=
# Together AI: https://api.together.ai/  → API Keys
TOGETHER_API_KEY=
# Fireworks AI: https://fireworks.ai/  → API Keys
FIREWORKS_API_KEY=
# OpenRouter: https://openrouter.ai/  → Keys
OPENROUTER_API_KEY=
# AI Proxy agent token (自定义，用于 agent 系统互信)
AI_PROXY_AGENT_TOKEN=
# Agent 编排层调用中转引擎时使用的令牌与默认策略/模型（留空则用服务内置默认）
AI_PROXY_STRATEGY=
AI_PROXY_AGENT_MODEL=
# OpenAI 兼容上游 base_url（默认指向本服务自身 /v1，一般无需修改）
APP_OPENAI_API_BASE_URL=

# ── 其他本地/自建模型服务（可选，留空即跳过）──
# LM Studio 本地服务: http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=
# Ollama 本地服务: http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
# NightRouter 聚合网关
NIGHTROUTER_BASE_URL=
NIGHTROUTER_API_KEY=
NIGHTROUTER_MODEL=

# ── py-service AI 多模型轮询（星途助手 / 博客 AI / 社区 AI 共用）──
# py-service 会自动在多个免费模型之间轮询：某个被限流或宕机时自动切换下一个，
# 全部候选都不可用才会报错。留空的 KEY 对应 provider 会被自动跳过（不会因此报错）。
#   · Pollinations 无需 key，可多模型轮换（默认即启用，零注册也有冗余）
#   · 以下为免费档（多数不需要信用卡）；填入 KEY 即自动加入轮询
# Gemini（AI Studio 免费档）: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Mistral（免费档）: https://console.mistral.ai/  → API Keys
MISTRAL_API_KEY=
# 可选：覆盖某 provider 的默认模型，例如
#   OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
#   GEMINI_MODEL=gemini-2.5-flash
#   GROQ_MODEL=openai/gpt-oss-20b
# 可选：单个 provider 的代理与专属请求参数（仅对该 provider 生效）
#   · <NAME>_PROXY      国内直连被 WAF 拦(403)的渠道走本地代理，如 GROQ_PROXY=http://127.0.0.1:7890
#   · <NAME>_EXTRA_JSON 附加请求参数，如 GROQ_EXTRA_JSON={"reasoning_effort":"low"}（推理模型提速）
#
# 也可显式声明整串候选（JSON 数组，优先级最高，格式与 secrets.json 的 ai_providers 一致）：
# AI_PROVIDERS=[{"name":"openrouter","base_url":"https://openrouter.ai/api/v1","api_key":"sk-or-xxx","model":"deepseek/deepseek-chat-v3-0324:free"},{"name":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key":"xxx","model":"gemini-2.5-flash"}]
AI_PROVIDERS=

# ── 本机免费模型池 Our Free Model（开源 dsh-our-free-model 的独立本地服务）──
# 免注册、免 Key：服务（默认 :18900）首次启动会自动生成 forwardKey 写入
# ~/.our-free-model/settings.json；py-service 免费 AI 通道会自行读取该文件，
# 故下面的 KEY 只需为 Java ai-proxy-service 的 Agent 直连通道填写。
# 留空 / 服务未运行时自动跳过，不影响其它上游。
# 服务随博客一键启动（见 start-all-services.ps1；仓库路径可用 OFM_REPO 覆盖）。
OUR_FREE_MODEL_KEY=
# 可选：地址与默认模型（不填即用 http://127.0.0.1:18900/v1 与 openrouter/free）
# 注意：匿名池整组模型（deepseek-v4.1-flash-free 等）可能被上游返回 403/LANE_LOCKED，
#       默认值取聚合入口 openrouter/free，避免开箱即用时报错。
OUR_FREE_MODEL_BASE_URL=
OUR_FREE_MODEL_MODEL=

# ── Supabase ──
# https://supabase.com/  → 项目 → Settings → API → service_role key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_TIMEOUT_MS=15000

# ── user-service 邮箱登录 + Google OAuth ──
# 邮箱验证码登录开关：false 时验证码只写服务端日志（不回传响应体，防「发码→取码→接管」链路）
MAIL_ENABLED=false
# SMTP 服务器（QQ邮箱 smtp.qq.com:465 / Gmail smtp.gmail.com:587）
MAIL_HOST=
MAIL_PORT=587
# SMTP 登录账号（通常是完整邮箱地址）
MAIL_USERNAME=
# SMTP 授权码（QQ邮箱: 设置→账户→SMTP；Gmail: App Password）——不是登录密码
MAIL_PASSWORD=
# 短信验证码登录开关（关闭时验证码只写日志）
SMS_ENABLED=false
# Google Cloud Console → API → 凭据 → OAuth 客户端 ID
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth 回调地址，必须与 Google 控制台登记的「已获授权的重定向 URI」完全一致
GOOGLE_REDIRECT_URI=http://localhost:8081/user/oauth/google/callback
# 未知邮箱首次登录是否自动注册。默认 false（须配合真实 SMTP/SMS 网关开启，否则等于开放注册）
AUTH_AUTO_REGISTER=false
# dev mock 登录开关（POST /user/oauth/google/dev-login），默认 false。
# 未启用真实 OAuth 时该接口可用任意邮箱登录任意账号（含管理员），仅本地调试需要时置 true，生产必须 false。
GOOGLE_DEV_LOGIN_ENABLED=false
# 前端站点地址（用于邮件/支付回跳链接）
FRONTEND_URL=http://localhost:5173
# 博客站点对外域名（RSS/Feed 里生成绝对链接用，生产环境改成正式域名）
BLOG_SITE_URL=http://localhost:5173

# ── py-service / 量化模块 ──
# 海泰智联财经: https://www.hithink.cn/  联系客服
HITHINK_FINANCE_API_KEY=
# 量化 LLM 调用（与 AI Proxy 提供商共用即可）
LLM_API_KEY=
# Tushare Pro: https://tushare.pro/  → 个人主页 → 获取 token
TUSHARE_TOKEN=
# EODHD: https://eodhd.com/  → Dashboard → API Token
EODHD_TOKEN=

# ── py-service / 视频模块 OSS ──
# 阿里云 RAM: https://ram.console.aliyun.com/  → 用户 → AccessKey
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 视频管理 token（自定义，用于管理接口鉴权）
VIDEO_ADMIN_TOKEN=
# 下载代理（yt-dlp 需要走代理才能访问的站点，如 http://127.0.0.1:7890；留空为直连）
MEDIA_DOWNLOAD_PROXY=
# 服务数据根目录（留空则用 py-service 目录自身）
SERVICE_BASE_DIR=

# ── py-service / OSINT 模块 ──
# Shodan: https://www.shodan.io/  → Account → API Key
SHODAN_API_KEY=

# ══════════════════════════════════════════════════════════════
# 支付平台（shop-service，可选 — 不配置时支付接口返回 503）
# ══════════════════════════════════════════════════════════════

# ── 支付宝官方支付（https://open.alipay.com → 控制台 → 应用）──
# APPID：应用列表 → 应用详情
# 私钥/公钥：应用详情 → 接口加签方式 → RSA2（去 BEGIN/END 头尾和换行）
# 网关：沙箱 https://openapi.alipaydev.com/gateway.do / 生产 https://openapi.alipay.com/gateway.do
# 回调 URL 必须公网可达，本项目复用 SakuraFrp 隧道：https://frp-six.com:44598/api/pay/notify/alipay
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_SIGN_TYPE=RSA2

# ── 微信支付官方（https://pay.weixin.qq.com → 商户平台）──
# 商户号/AppID：账户中心 → 商户信息
# APIv3 密钥：账户中心 → API 安全 → 设置 APIv3 密钥（32 位）
# 证书序列号：账户中心 → API 安全 → 管理证书
# 商户私钥：apiclient_key.pem 内容（去 BEGIN/END 头尾和换行）
# 回调 URL：https://frp-six.com:44598/api/pay/notify/wechat
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_APIV3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_NOTIFY_URL=

